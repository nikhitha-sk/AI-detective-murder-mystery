    "ioredis": "^5.11.1",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "tsx": "^4.20.6",
    "xstate": "^5.23.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
