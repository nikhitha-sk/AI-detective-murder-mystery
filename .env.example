# ---------------------------------------------------------------
# AI Detective Murder Mystery - environment
# Copy to .env (cp .env.example .env) and fill in what you need.
# ---------------------------------------------------------------

# --- LLM ---------------------------------------------------------
# "groq" uses Groq (free tier: https://console.groq.com/keys).
# "anthropic" uses Claude. "mock" uses built-in hand-written cases and
# rule-based suspects (no API key, no cost) - handy for testing the game loop.
# "auto" (default) = groq if GROQ_API_KEY is set, else anthropic if
# ANTHROPIC_API_KEY is set, otherwise mock.
LLM_PROVIDER=auto
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Models. Leave empty to use the provider's defaults:
#   Groq:   main openai/gpt-oss-120b, solver openai/gpt-oss-20b, suspects qwen/qwen3.8-27b, guard openai/gpt-oss-20b
#   Claude: main claude-opus-5-5, suspects claude-opus-5-5, guard claude-haiku-5-5
# Case generation.
MODEL_MAIN=
# Fairness check on each new case. On Groq, keep it a different model from
# MODEL_MAIN (default openai/gpt-oss-20b): each model has its own free-tier
# limit, and if one model does both it hits "Rate limit reached".
MODEL_SOLVER=
# Suspect replies (most of the calls in a game).
MODEL_SUSPECT=
# Small, fast model for the reply guard, conversation summaries and new settings.
MODEL_GUARD=

# --- Game server -------------------------------------------------
SERVER_PORT=4300
# Comma-separated list of allowed browser origins (the Next.js app).
CLIENT_ORIGIN=http://localhost:3300

# Live state. Leave empty to use an in-memory store (single instance only).
REDIS_URL=redis://localhost:56379
# Persistence. Leave empty to skip saving cases/games/messages.
DATABASE_URL=postgres://mystery:mystery@localhost:55432/mystery

# --- Game rules (seconds / counts) ---------------------------------
ROUNDS=3
BRIEFING_SECONDS=60
ROUND_SECONDS=240
DISCUSSION_SECONDS=120
VOTE_SECONDS=60
QUESTIONS_PER_ROUND=6
ROOM_TOKEN_BUDGET=600000

# --- Web client --------------------------------------------------
NEXT_PUBLIC_SERVER_URL=http://localhost:4300
