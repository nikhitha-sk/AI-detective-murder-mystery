# ---------------------------------------------------------------
# AI Detective Murder Mystery - environment
# Copy to .env (cp .env.example .env) and fill in what you need.
# ---------------------------------------------------------------

# --- LLM ---------------------------------------------------------
# "anthropic" uses Claude. "mock" uses built-in hand-written cases and
# rule-based suspects (no API key, no cost) - handy for testing the game loop.
# "auto" (default) = anthropic if a key is set, otherwise mock.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=

# Stronger model for case generation, the solver and suspect agents.
MODEL_MAIN=claude-opus-5-5
# Small, cheap model for the reply guard and conversation summaries.
MODEL_GUARD=claude-haiku-5-5

# --- Game server -------------------------------------------------
SERVER_PORT=4300
# Comma-separated list of allowed browser origins (the Next.js app).
CLIENT_ORIGIN=http://localhost:3300

# Live state. Leave empty to use an in-memory store (single instance only).
REDIS_URL=redis://localhost:56379
# Persistence. Leave empty to skip saving cases/games/messages.
DATABASE_URL=postgres://mystery:mystery@localhost:55432/mystery

# --- Game rules (seconds / counts) ---------------------------------
ROUNDS=3
BRIEFING_SECONDS=60
ROUND_SECONDS=240
DISCUSSION_SECONDS=120
VOTE_SECONDS=60
QUESTIONS_PER_ROUND=6
ROOM_TOKEN_BUDGET=600000

# --- Web client --------------------------------------------------
NEXT_PUBLIC_SERVER_URL=http://localhost:4300
